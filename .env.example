# 复制为 .env 后填值（本地调试用；GitHub 上填到 Settings -> Secrets）
# 雪球大V用户ID（主页 u/ 后面那串数字），多个用逗号分隔
XUEQIU_USER_IDS=6515752937,1821992043

# 三级后端（均原生多模态，图文通吃），按顺序尝试：
# 1) 商汤日日新 SenseNova DeepSeek-V4.1-Flash（deepseek-flash，免费；2026-09-24 起首选）
# 2) Agnes AI agnes-3.0-flash（免费多模态；2026-11-25 由 2.5 升级，2.5 于 2026-11-30 下线）
# 3) Google Gemini 3 Flash（免费，1500 RPD 独立配额桶；2026-09-16 已在 news-feed 验证稳定）
# 只需填下面三个 Key；模型ID有默认值，一般不用改。
SENSENOVA_API_KEY=     # sk-...    （第1后端 SenseNova，首选）
AGNES_API_KEY=         # sk-...    （第2后端 Agnes AI）
GEMINI_API_KEY=        # ...       （第3后端 Gemini 3 Flash；模型名必须带 -preview 后缀）

# 可选覆盖（一般不用改，默认值已配置好）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-3-flash-preview
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_MODEL=deepseek-flash
# 超时（秒）：Gemini 60（含 budget=60 总时限的平衡取值），Agnes 30，SenseNova 30
# GEMINI_TIMEOUT=60
# AGNES_TIMEOUT=30
# SENSENOVA_TIMEOUT=30
PAGES=2
HEADLESS=true
